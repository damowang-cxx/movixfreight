FROM node:22-alpine AS build

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

COPY apps/api/package.json apps/api/package.json
COPY apps/admin-web/package.json apps/admin-web/package.json
COPY apps/customer-web/package.json apps/customer-web/package.json

COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/pricing-engine/package.json packages/pricing-engine/package.json
COPY packages/connector-sdk/package.json packages/connector-sdk/package.json

RUN pnpm install --frozen-lockfile

COPY . .

# API 依赖 @movix/pricing-engine。
# pricing-engine 的 main/types 指向 dist，因此必须先构建它。
RUN pnpm --filter @movix/pricing-engine build

RUN pnpm --filter @movix/api prisma:generate

RUN pnpm --filter @movix/api build

# Test compiled CommonJS + Linux native image conversion without UPS/DB requests.
RUN node apps/api/test/ups-built-smoke.cjs

FROM node:22-alpine

WORKDIR /app

ENV NODE_ENV=production

COPY --from=build /app /app

CMD ["node", "apps/api/dist/main.js"]
