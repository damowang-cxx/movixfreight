NODE_ENV=production
PORT=3000
POSTGRES_USER=movix_prod
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=movix_freight
REDIS_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=28800
CORS_ORIGINS=https://your-domain.example
CONNECTOR_CONFIG_PATH=/run/secrets/connectors.json
MOVIX_DOMAIN=your-domain.example
DISPATCH_WORKER_CONCURRENCY=1
# 仅用于首次初始化管理员；已存在同名管理员时不会覆盖既有密码。
ADMIN_BOOTSTRAP_USERNAME=movix
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-initial-admin-password
